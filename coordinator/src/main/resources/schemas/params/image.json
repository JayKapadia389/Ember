{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember.dev/schemas/params/image.json",
  "title": "Params shared by image models",
  "type": "object",
  "required": ["prompt"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "negative_prompt": { "type": "string", "maxLength": 1000 },
    "num_inference_steps": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
    "guidance_scale": { "type": "number", "minimum": 0, "maximum": 20, "default": 7.5 },
    "seed": { "type": "integer", "minimum": 0 }
  }
}
