{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember.dev/schemas/params/text.json",
  "title": "Params shared by text models",
  "type": "object",
  "required": ["prompt"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "max_new_tokens": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 256 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 },
    "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.8 },
    "seed": { "type": "integer", "minimum": 0 }
  }
}
